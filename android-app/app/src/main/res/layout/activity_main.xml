<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- 상단 파란색 띠 (상단바 아래에 위치) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#2563EB"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- 좌측: 성경 본문 찾는 창을 여는 아이콘 -->
        <ImageButton
            android:id="@+id/searchIconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="성경 검색"
            android:src="@drawable/ic_search" />

        <!-- 가운데: 성경의 종류 (개역개정, KJV, 새번역 등) -->
        <TextView
            android:id="@+id/bibleTitleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="개역개정"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- 우측: 옵션 창을 여는 아이콘 -->
        <ImageButton
            android:id="@+id/settingsIconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="옵션 설정"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- 중앙 영역: 현재 읽고 있는 본문 표시 (하단 바에 가리지 않도록 하단 패딩 추가) -->
    <ScrollView
        android:id="@+id/bibleScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="16dp"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/bibleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="8dp"
                android:justificationMode="inter_word"
                android:breakStrategy="simple"
                android:text="재생 버튼을 누르면 성경 본문이 여기에 실시간으로 표시됩니다."
                android:textColor="#0F172A"
                android:textSize="18sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 하단 파란색 띠 (Bottom Bar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#2563EB"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- 좌측: 재생/정지 토글 아이콘 (오른삼각형 / 두줄 가로선) -->
        <ImageButton
            android:id="@+id/playPauseToggleButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="재생/일시정지"
            android:src="@drawable/ic_play" />

        <!-- 가운데: 현재 읽고 있는 부분의 성경책 장절 -->
        <TextView
            android:id="@+id/currentPositionTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="창세기 1장"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 오른쪽: 미정 우측 유틸리티 아이콘 -->
        <ImageButton
            android:id="@+id/utilityIconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="유틸리티"
            android:src="@drawable/ic_volume" />
    </LinearLayout>

</LinearLayout>
