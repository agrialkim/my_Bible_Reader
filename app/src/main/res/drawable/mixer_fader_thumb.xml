<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 앰프/믹서기 볼륨 조절기 스타일 사각형 손잡이 -->
    <item>
        <shape android:shape="rectangle">
            <size
                android:width="22dp"
                android:height="36dp" />
            <solid android:color="#2563EB" />
            <stroke
                android:width="1.5dp"
                android:color="#1E3A8A" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- 중앙 가로 흰색 표시선 (믹서 노브 표시선) -->
    <item
        android:top="17dp"
        android:bottom="17dp"
        android:left="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
