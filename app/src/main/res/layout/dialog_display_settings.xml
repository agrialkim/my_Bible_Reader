<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <!-- 테마 선택 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="화면 모드"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/themeNormalBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                style="?android:attr/buttonBarButtonStyle"
                android:background="#E2E8F0"
                android:padding="0dp"
                android:text="일반"
                android:textSize="13sp" />

            <Button
                android:id="@+id/themeDarkBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="2dp"
                style="?android:attr/buttonBarButtonStyle"
                android:background="#E2E8F0"
                android:padding="0dp"
                android:text="다크"
                android:textSize="13sp" />

            <Button
                android:id="@+id/themeBlueBtn"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                style="?android:attr/buttonBarButtonStyle"
                android:background="#E2E8F0"
                android:padding="0dp"
                android:text="블루라이트"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 서체 선택 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="서체 (글꼴)"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/fontFamilySpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#F1F5F9"
            android:minHeight="36dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="4dp" />

        <!-- 폰트 크기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="글씨 크기"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:textSize="14sp" />

            <Button
                android:id="@+id/fontMinusBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:backgroundTint="#F1F5F9"
                android:textColor="#0F172A"
                android:padding="0dp"
                android:text="-"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/fontValueText"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="12"
                android:textColor="#334155"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/fontPlusBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:backgroundTint="#F1F5F9"
                android:textColor="#0F172A"
                android:padding="0dp"
                android:text="+"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 미리보기 박스 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="미리보기"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/fontPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="@drawable/preview_box_border">

            <TextView
                android:id="@+id/fontPreviewTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="태초에 하나님이 천지를 창조하시니라"
                android:textColor="#0F172A"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 스크롤 속도 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="스크롤 속도"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <SeekBar
                android:id="@+id/displaySpeedSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/displaySpeedValue"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="1.0배"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 시작 지연 시간 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="시작 지연 시간"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">
            <SeekBar
                android:id="@+id/delaySeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="4" />
            <TextView
                android:id="@+id/delayValue"
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="15초"
                android:textColor="#334155"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>